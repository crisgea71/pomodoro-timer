{
  "name": "pomodoro-focus",
  "version": "1.0.0",
  "description": "Pomodoro timer with AI encouragement",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "com.pomodoro.focus",
    "productName": "Pomodoro Focus",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
